  {
    "id": "unique.Order.Order_orderNo_key",
    "label": "Add unique constraint on \"Order\" (orderNo)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Order_orderNo_key",
        "table": "Order"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Order_orderNo_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Order_orderNo_key",
          "public",
          "\"public\".\"Order\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Order_orderNo_key\"",
        "sql": "ALTER TABLE \"public\".\"Order\" ADD CONSTRAINT \"Order_orderNo_key\" UNIQUE (\"orderNo\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"Order_orderNo_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Order_orderNo_key",
          "public",
          "\"public\".\"Order\""
        ]
      }
    ]
  }
